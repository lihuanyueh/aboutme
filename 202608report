        </p>
      </div>

      <!-- Interactive Tab Selector for 5 Evolution Stages -->
      <div class="flex flex-wrap gap-2 pb-2">
        <button onclick="selectEvolutionStage(1)" id="stage-btn-1" class="tab-btn active px-4 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-white">
