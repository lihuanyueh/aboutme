        <button onclick="selectEvolutionStage(3)" id="stage-btn-3" class="tab-btn px-4 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-white text-slate-600 hover:border-sky-400">
