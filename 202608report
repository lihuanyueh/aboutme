        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          選擇你想在遊戲中說明的狀況，試試看如何運用「總監級 Prompt 秘笈」把模糊的想法變成給 AI 的超級指令！
        </p>

        <!-- Sandbox Form -->
        <div class="bg-slate-800/80 rounded-2xl p-5 border border-slate-700 space-y-4 mt-6">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-2">1. 選擇你想要加入或修復的遊戲需求：</label>
            <select id="sb-issue" onchange="updatePromptSandbox()" class="w-full bg-slate-900 border border-slate-600 rounded-xl px-3 py-2 text-xs sm:text-sm text-slate-100 focus:outline-none focus:border-amber-400">
              <option value="too-hard">敵人太強了，我一下就被打死</option>
              <option value="visual-gear">我想讓武器看起來更厲害</option>
              <option value="camera-move">主角跑太快，超出螢幕看不到畫面了</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Bad Prompt Output -->
            <div class="bg-red-950/40 border border-red-800/50 rounded-xl p-3">
              <span class="text-[10px] font-bold text-red-400 block mb-1">❌ 一般新手 Prompt (模糊)</span>
              <p id="sb-bad-text" class="text-xs text-red-200 font-mono">「遊戲好難，改簡單一點」</p>
            </div>

            <!-- Great Prompt Output -->
            <div class="bg-emerald-950/40 border border-emerald-800/50 rounded-xl p-3">
              <span class="text-[10px] font-bold text-emerald-400 block mb-1">🌟 總監級 Prompt (精準秘笈)</span>
              <p id="sb-good-text" class="text-xs text-emerald-200 font-mono">「請幫我加入 1.5 秒受傷無敵閃爍保護，這樣被打到就不會連續扣血！」</p>
            </div>
          </div>

          <div class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-xs text-amber-200 flex items-center justify-between">
            <span id="sb-tip">💡 秘笈解析：明確指出機制與期待的效果，AI 就能精準寫出代碼！</span>
            <button onclick="copyGoodPrompt()" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-3 py-1 rounded-lg text-xs transition shadow">
              複製優秀 Prompt
            </button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 py-6 text-center text-xs">
    <div class="max-w-7xl mx-auto px-4 space-y-2">
      <p>🚀 繼續保持你的創造力，你已經是一個超棒的小遊戲設計師了！</p>
      <p class="text-slate-600">骷髏迷宮戰鬥遊戲 • 遊戲演變與 Prompt 進化分析報告 SPA</p>
    </div>
  </footer>

  <!-- JAVASCRIPT INTERACTION LOGIC -->
  <script>
    /* --------------------------------------------------------------------------
       1. DATA STRUCTURES FOR EVOLUTION STAGES & PROMPTS
       -------------------------------------------------------------------------- */
    const stageData = {
      1: {
        title: "1. 核心規則與屬性（玩法基石）",
        tag: "玩法基石",
        badge: "階段 1 / 5",
        desc: "在遊戲開發最初，你定義了四種靈魂超能力屬性，為戰鬥奠定了豐富多彩的互動規則：",
        features: [
          { icon: "🔥", name: "火屬性", detail: "持續燃燒傷害效果" },
          { icon: "⚡", name: "電屬性", detail: "立即扣血高爆發" },
          { icon: "❄️", name: "冰屬性", detail: "定格 5 秒無法移動" },
          { icon: "💨", name: "加速屬性", detail: "迅速往前衝刺避險" }
        ],
        insight: "先把基本的玩法與能力定好，遊戲骨架就成立了！"
      },
      2: {
        title: "2. 世界觀與鏡頭（畫面升級）",
        tag: "視覺與鏡頭",
        badge: "階段 2 / 5",
        desc: "從平淡的單圖升級為具備空間感的地圖與視角，大幅提升探索樂趣：",
        features: [
          { icon: "🧱", name: "3D 立體石磚牆", detail: "具備高低光影的迷宮牆" },
          { icon: "🌿", name: "生動綠藤蔓", detail: "牆面隨機生成藤蔓細節" },
          { icon: "🌾", name: "草叢隱身", detail: "可躲藏避開怪物視線" },
          { icon: "🎥", name: "動態鏡頭跟隨", detail: "螢幕跟著角色平滑移動" },
          { icon: "🗺️", name: "全景雷達小地圖", detail: "右上角即時顯示敵我位置" }
        ],
        insight: "鏡頭跟隨與雷達讓小迷宮瞬間變成大世界冒險！"
      },
      3: {
        title: "3. 角色外觀與紙娃娃換裝（美術細節）",
        tag: "紙娃娃系統",
        badge: "階段 3 / 5",
        desc: "打造了獨一無二的角色視覺形象，並支援豐富的換裝自訂能力：",
        features: [
          { icon: "💀", name: "立體骷髏面孔", detail: "眼眶、發光瞳孔與倒三角牙齒" },
          { icon: "🪖", name: "多彩全身裝備", detail: "頭套、衣服、褲子、鞋子、武器、盾牌" },
          { icon: "🚶", name: "直立站姿", detail: "正面顯示角色與裝備" },
          { icon: "🛌", name: "橫躺姿態", detail: "可自由切換動作形態" }
        ],
        insight: "紙娃娃系統讓玩家有強烈的角色歸屬感！"
      },
      4: {
        title: "4. 夥伴與戰鬥系統（豐富互動）",
        tag: "軍團協力",
        badge: "階段 4 / 5",
        desc: "獨木難支？你為遊戲加入了強力的戰鬥小隊！",
        features: [
          { icon: "🤝", name: "骷髏夥伴軍團", detail: "自動跟隨並保護主角" },
          { icon: "⚔️", name: "主動幫打怪", detail: "夥伴會鎖定附近敵人攻擊" },
          { icon: "🛡️", name: "夥伴裝備共享", detail: "可以幫夥伴穿上武器與防具" }
        ],
        insight: "夥伴軍團大幅增加了戰鬥的熱鬧感與策略性！"
      },
      5: {
        title: "5. 遊戲平衡調整（耐玩度優化）",
        tag: "數值平衡",
        badge: "階段 5 / 5",
        desc: "發現「一下就被打死」後，進行精準的遊戲體驗優化：",
        features: [
          { icon: "✨", name: "1.5秒受傷無敵", detail: "閃爍保護，避免連擊秒殺" },
          { icon: "❤️", name: "胸甲生命加成", detail: "穿上鋼鐵護胸 HP 提升至 15" },
          { icon: "🎯", name: "AI 難度調整", detail: "可自訂 1~10 級對手反應速度" }
        ],
        insight: "合理的無敵時間與 HP 成長，讓遊戲變得非常好玩不挫折！"
      }
    };

    /* --------------------------------------------------------------------------
       2. EVOLUTION STAGE UI SWITCHING
       -------------------------------------------------------------------------- */
    function selectEvolutionStage(stageNum) {
      // Update Tab UI styles
      for(let i=1; i<=5; i++) {
        const btn = document.getElementById(`stage-btn-${i}`);
        if (i === stageNum) {
          btn.className = "tab-btn active px-4 py-2 rounded-xl border border-sky-600 text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-sky-600 text-white shadow-md";
        } else {
          btn.className = "tab-btn px-4 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-white text-slate-600 hover:border-sky-400";
        }
      }

      // Populate Card Details
      const data = stageData[stageNum];
      document.getElementById('stage-badge').innerText = data.badge;
      document.getElementById('stage-tag').innerText = data.tag;
      document.getElementById('stage-title').innerText = data.title;
      document.getElementById('stage-desc').innerText = data.desc;
      document.getElementById('stage-insight').innerText = data.insight;

      const featuresContainer = document.getElementById('stage-features');
      featuresContainer.innerHTML = '';
      data.features.forEach(f => {
        const item = document.createElement('div');
        item.className = "p-3 bg-slate-50 rounded-xl border border-slate-200/80 flex items-start space-x-2.5";
        item.innerHTML = `
          <span class="text-xl">${f.icon}</span>
          <div>
            <div class="text-xs font-bold text-slate-800">${f.name}</div>
            <div class="text-[11px] text-slate-500">${f.detail}</div>
          </div>
        `;
        featuresContainer.appendChild(item);
      });
    }

    /* --------------------------------------------------------------------------
       3. CHART.JS CANVAS INITIALIZATION
       -------------------------------------------------------------------------- */
    // Chart 1: Donut Chart for Attributes
    const ctxAttr = document.getElementById('attributeChart').getContext('2d');
    new Chart(ctxAttr, {
      type: 'doughnut',
      data: {
        labels: ['🔥 火屬性(燃燒)', '⚡ 電屬性(扣血)', '❄️ 冰屬性(定格5s)', '💨 加速(往前衝)'],
        datasets: [{
          data: [25, 25, 25, 25],
          backgroundColor: ['#ef4444', '#a855f7', '#06b6d4', '#eab308'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              boxWidth: 12,
              font: { size: 10 }
            }
          }
        }
      }
    });

    // Chart 2: Evolution Complexity Growth Curve
    const ctxEvolution = document.getElementById('evolutionChart').getContext('2d');
    new Chart(ctxEvolution, {
      type: 'line',
      data: {
        labels: ['Stage 1', 'Stage 2', 'Stage 3', 'Stage 4', 'Stage 5'],
        datasets: [{
          label: '遊戲好玩度與豐富度',
          data: [20, 45, 65, 85, 98],
          borderColor: '#0284c7',
          backgroundColor: 'rgba(2, 132, 199, 0.1)',
          fill: true,
          tension: 0.35,
          pointBackgroundColor: '#f59e0b',
          pointRadius: 6,
          pointHoverRadius: 8
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: true,
            max: 100,
            ticks: {
              callback: function(value) { return value + '%'; },
              font: { size: 10 }
            }
          },
          x: {
            ticks: { font: { size: 10 } }
          }
        },
        plugins: {
          legend: { display: false }
        }
      }
    });

    /* --------------------------------------------------------------------------
       4. PROMPT CASE SWITCHER & SANDBOX
       -------------------------------------------------------------------------- */
    function showPromptCase(caseNum) {
      const insightBox = document.getElementById('case-insight-box');
      if (caseNum === 1) {
        insightBox.innerHTML = `<b>案例 1 解析：</b> 提出「螢幕要跟著角色移動」，精準抓出鏡頭問題，讓 AI 實作動態 Lerp 鏡頭跟隨！`;
      } else if (caseNum === 2) {
        insightBox.innerHTML = `<b>案例 2 解析：</b> 提出「頭盔不想要遮到眼睛」，指出美術穿模問題，使 AI 調整了圖層畫布順序！`;
      } else if (caseNum === 3) {
        insightBox.innerHTML = `<b>案例 3 解析：</b> 提出「我不能一下就被打死」，指出數值問題，成功加入 1.5 秒無敵閃爍時間！`;
      } else if (caseNum === 4) {
        insightBox.innerHTML = `<b>案例 4 解析：</b> 提出「武器顏色要不一樣，夥伴也能裝備」，成功擴充裝備系統與小隊夥伴共享！`;
      }
    }

    const sandboxData = {
      "too-hard": {
        bad: "「遊戲好難，改簡單一點」",
        good: "「我不能一下就被打死，請幫我加入 1.5 秒受傷無敵閃爍保護時間！」",
        tip: "💡 秘笈解析：明確指出『受傷無敵閃爍保護』與『1.5秒』，AI 能直接寫出準確代碼！"
      },
      "visual-gear": {
        bad: "「劍太醜了，換好看一點」",
        good: "「請幫我設計一把會發出紫光的雷霆聖劍，攻擊時要帶有炫酷的刀芒特效！」",
        tip: "💡 秘笈解析：使用『紫光』、『雷霆聖劍』與『刀芒特效』，給予 AI 具體的視覺形容！"
      },
      "camera-move": {
        bad: "「我看不到主角了」",
        good: "「主角跑動時螢幕要跟著角色移動，把角色保持在畫面中央！」",
        tip: "💡 秘笈解析：描述希望發生的畫面行為（動態鏡頭跟隨），AI 就知道要加入 Camera 跟隨機制！"
      }
    };

    function updatePromptSandbox() {
      const issueKey = document.getElementById('sb-issue').value;
      const data = sandboxData[issueKey];
      document.getElementById('sb-bad-text').innerText = data.bad;
      document.getElementById('sb-good-text').innerText = data.good;
      document.getElementById('sb-tip').innerText = data.tip;
    }

    function copyGoodPrompt() {
      const text = document.getElementById('sb-good-text').innerText;
      navigator.clipboard.writeText(text).then(() => {
        alert('🎉 已複製優秀 Prompt！你可以直接貼給 AI 試試看：\n' + text);
      });
    }

    function scrollToSection(id) {
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Initialize Default States
    selectEvolutionStage(1);
    updatePromptSandbox();
  </script>
</body>
</html>
