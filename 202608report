        <button onclick="selectEvolutionStage(4)" id="stage-btn-4" class="tab-btn px-4 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-white text-slate-600 hover:border-sky-400">
          <span>🤝 Stage 4</span>
          <span>夥伴軍團系統</span>
        </button>
        <button onclick="selectEvolutionStage(5)" id="stage-btn-5" class="tab-btn px-4 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-white text-slate-600 hover:border-sky-400">
